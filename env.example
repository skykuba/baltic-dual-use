# Lokalna instancja Overpass (infra/overpass/docker-compose.yml).
# Skopiuj ten plik do .env.local — .env* jest w .gitignore.
OVERPASS_URL=https://composedly-listless-tinley.ngrok-free.dev/

# Publiczna instancja jako awaryjne źródło, gdy lokalna nie wstała.
# Ma limity (~10k zapytań/dzień, odrzuca duplikaty) — nie polegaj na niej w demo.
OVERPASS_FALLBACK_URL=https://composedly-listless-tinley.ngrok-free.dev/

# Katalog cache'u odpowiedzi Overpassa (względem roota repo).
OSM_CACHE_DIR=.cache/osm

# ── Kafle mapy bazowej ───────────────────────────────────────────────────
#
# Lista rozdzielona przecinkami; pierwsze działające źródło wygrywa.
# Domyślnie tile.openstreetmap.org — jedyne, o którym wiadomo na pewno,
# że nie wymaga klucza API.
#
# UWAGA: dostawcy wymagający klucza (np. CARTO) często zwracają HTTP 200
# z OBRAZKIEM "API KEY REQUIRED" zamiast błędu. Proxy nie ma jak odróżnić
# takiego kafla od prawdziwego i zapisze go do cache'u na tydzień.
# Po każdej zmianie tej zmiennej wyczyść cache:
#   rm -rf .cache/tiles
#
# TILE_SOURCES=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Katalog cache'u kafli (względem roota repo).
# TILE_CACHE_DIR=.cache/tiles

# Archiwum PMTiles dla pełnego trybu offline (opcjonalne).
# Gdy ustawione, mapa bazowa jest wektorowa i nie wymaga sieci w ogóle.
# NEXT_PUBLIC_PMTILES_URL=/maps/pomorskie.pmtiles
